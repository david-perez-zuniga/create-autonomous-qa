---
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<article
  class="group relative flex flex-col gap-4 rounded-3xl border border-white/10 bg-white/[0.03] p-8 shadow-glow backdrop-blur-xl transition duration-500 hover:border-indigo-400/60 hover:bg-white/[0.05]"
>
  <div class="absolute -top-24 -right-24 h-48 w-48 rounded-full bg-indigo-500/20 blur-3xl transition group-hover:bg-cyan-400/25"></div>
  <h3 class="text-xl font-semibold text-white sm:text-2xl">{title}</h3>
  <p class="text-pretty leading-relaxed text-slate-300">{description}</p>
  <slot />
</article>
