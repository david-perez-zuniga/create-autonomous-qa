---
const links = [
  { href: "#features", label: "Features" },
  { href: "#fases", label: "Fases" },
  { href: "#faq", label: "FAQ" },
];
---

<header
  class="sticky top-0 z-50 border-b border-white/5 bg-background/70 backdrop-blur-xl"
>
  <div
    class="mx-auto flex w-full max-w-7xl items-center justify-between gap-6 px-6 py-4"
  >
    <a href="#top" class="group flex items-center gap-3">
      <span
        class="font-mono text-sm font-semibold tracking-tight text-white transition group-hover:text-indigo-200"
        >create-autonomous-qa</span
      >
    </a>

    <nav class="hidden items-center gap-8 md:flex">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="text-sm text-slate-300 transition hover:text-white"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <a
        href="https://github.com/david-perez-zuniga/create-autonomous-qa"
        target="_blank"
        rel="noopener"
        class="hidden rounded-full border border-white/10 bg-white/[0.06] px-4 py-2 text-sm text-slate-200 transition hover:border-indigo-400/60 hover:bg-white/10 sm:inline-flex"
        >GitHub</a
      >
      <a
        href="#install"
        class="inline-flex items-center gap-2 rounded-full bg-indigo-500 px-5 py-2 text-sm font-medium text-white shadow-glow transition hover:bg-indigo-400"
      >
        <span class="hidden sm:inline">Empezar</span>
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</header>
