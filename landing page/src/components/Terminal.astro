---
const lines = [
  { type: "command", icon: "", text: "npx create-autonomous-qa@latest banking-qa" },
  { type: "output", icon: "rocket", text: "Creating Autonomous QA Project" },
  { type: "success", icon: "check", text: "Template copied" },
  { type: "success", icon: "check", text: "package.json configured" },
  { type: "success", icon: "check", text: "README configured" },
  { type: "success", icon: "check", text: "Skill installed" },
  { type: "info", icon: "", text: "Project created successfully" },
  { type: "info", icon: "", text: "" },
  { type: "label", icon: "", text: "Next steps:" },
  { type: "info", icon: "", text: "" },
  { type: "muted", icon: "", text: "cd banking-qa" },
  { type: "muted", icon: "", text: "pnpm install" },
  { type: "muted", icon: "", text: "pnpm test" },
];
---

<div
  class="code-block relative overflow-hidden rounded-3xl"
  aria-label="Salida de la terminal"
>
  <div
    class="flex items-center justify-between border-b border-white/5 px-6 py-4"
  >
    <div class="flex items-center gap-2">
      <span class="h-3 w-3 rounded-full bg-rose-400/80"></span>
      <span class="h-3 w-3 rounded-full bg-amber-300/80"></span>
      <span class="h-3 w-3 rounded-full bg-emerald-400/80"></span>
    </div>
    <span class="font-mono text-xs text-slate-400">~/proyectos</span>
  </div>

  <div class="px-6 py-6 font-mono text-sm leading-relaxed">
    {
      lines.map((line, index) => (
        <p
          data-terminal-line
          data-type={line.type}
          class="terminal-line opacity-0"
          style={`--delay: ${index * 110}ms`}
        >
          {line.type === "command" ? (
            <span class="mr-2 select-none text-emerald-400">$</span>
          ) : line.icon === "check" ? (
            <svg
              width="14"
              height="14"
              viewBox="0 0 16 16"
              fill="none"
              class="mr-2 inline-block -translate-y-px select-none text-emerald-400"
              aria-hidden="true"
            >
              <circle cx="8" cy="8" r="7" fill="currentColor" opacity="0.18" />
              <path
                d="M4.5 8.2l2.3 2.3 4.7-4.9"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          ) : line.icon === "rocket" ? (
            <svg
              width="13"
              height="13"
              viewBox="0 0 16 16"
              fill="none"
              class="mr-2 inline-block -translate-y-px select-none text-indigo-300"
              aria-hidden="true"
            >
              <path
                d="M9.2 1.3 3.4 8.2c-.3.35-.1.9.35.95l2.6.28-1.1 4.2c-.13.5.44.85.83.51l6.1-5.8c.3-.28.2-.75-.19-.9L9.9 5.6l.6-2.9c.1-.5-.3-.85-.79-.63Z"
                fill="currentColor"
              />
            </svg>
          ) : null}
          <span
            class={
              line.type === "command"
                ? "text-white"
                : line.type === "success"
                  ? "text-emerald-300"
                  : line.type === "label"
                    ? "text-white"
                    : line.type === "output"
                      ? "text-slate-200"
                      : "text-slate-400"
            }
          >
            {line.text || "\u00A0"}
          </span>
        </p>
      ))
    }
    <p data-terminal-cursor class="mt-1 inline-block text-slate-100">
      <span class="text-emerald-400">$</span>
      <span
        class="ml-1 inline-block h-4 w-2 translate-y-0.5 bg-slate-100"
      ></span>
    </p>
  </div>
</div>

<style>
  .terminal-line {
    animation: terminal-in 0.4s ease forwards;
    animation-delay: var(--delay);
  }

  @keyframes terminal-in {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .terminal-line {
      animation: none;
      opacity: 1;
    }
  }
</style>
