---
const tree = `mi-proyecto-qa/
├── tests/                      # Suites de Playwright
│   └── example.spec.ts
├── pages/                      # Page Objects
├── fixtures/                   # Fixtures compartidos
├── qa-results/
│   ├── defects/                # Defectos detectados
│   ├── evidence/               # Screenshots, vídeos, trazas
│   │   ├── screenshots/
│   │   ├── videos/
│   │   ├── traces/
│   │   ├── console/
│   │   └── network/
│   ├── analytics/              # Métricas de ejecución
│   └── playwright/             # Reportes HTML y JSON
├── .opencode/
│   └── skills/
│       └── autonomous-qa/      # Skill de QA autónomo
│           └── skill.md
├── playwright.config.ts
├── .env.example
├── .gitignore
├── package.json
└── README.md`;
---

<div
  class="code-block overflow-hidden rounded-3xl"
>
  <div class="flex items-center justify-between border-b border-white/5 px-6 py-4">
    <div class="flex items-center gap-2">
      <span class="h-3 w-3 rounded-full bg-rose-400/80"></span>
      <span class="h-3 w-3 rounded-full bg-amber-300/80"></span>
      <span class="h-3 w-3 rounded-full bg-emerald-400/80"></span>
    </div>
    <span class="font-mono text-xs text-slate-400"></span>
  </div>
  <pre
    class="overflow-x-auto px-6 py-6 text-left font-mono text-xs leading-relaxed text-slate-300 sm:text-sm"><code>{tree}</code></pre>
</div>
