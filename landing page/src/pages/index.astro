---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Terminal from "../components/Terminal.astro";
import Card from "../components/Card.astro";
import Phases from "../components/Phases.astro";
import Faq from "../components/Faq.astro";
import Tree from "../components/Tree.astro";

const features = [
  {
    title: "Scaffold instantáneo",
    description:
      "Genera un proyecto completo de QA autónomo con Playwright, TypeScript y una skill para agentes de IA en segundos.",
  },
  {
    title: "pnpm o Bun",
    description:
      "Con --pnpm (por defecto) o --bun el proyecto generado usa el package manager que prefieras, incluido en package.json, README y skill.",
  },
  {
    title: "Estructura lista para usar",
    description:
      "Tests, Page Objects, fixtures, evidencias, Playwright config completo, .env.example, .gitignore y la skill de OpenCode.",
  },
  {
    title: "Seguro por diseño",
    description:
      "Validación de nombres, bloqueo de path traversal, nombres reservados de Windows y rollback completo ante cualquier fallo.",
  },
  {
    title: "Errores claros",
    description:
      "Contrato de salida estable, errores por stderr, códigos de salida documentados y stack traces con --debug.",
  },
  {
    title: "Skill para agentes IA",
    description:
      "9 fases autonomously: descubrimiento, reglas, escenarios, casos, código, ejecución, evidencias, defectos y reporte.",
  },
];

const installCommands = [
  { pm: "npm", cmd: "npm create autonomous-qa@latest mi-proyecto" },
  { pm: "pnpm", cmd: "pnpm create autonomous-qa mi-proyecto" },
  { pm: "bun", cmd: "bun create autonomous-qa mi-proyecto" },
  { pm: "npx", cmd: "npx create-autonomous-qa@latest mi-proyecto" },
];

const stats = [
  { value: "73", label: "tests pasando" },
  { value: "86%", label: "cobertura" },
  { value: "3", label: "sistemas operativos" },
  { value: "< 1s", label: "tiempo de scaffold" },
];
---

<BaseLayout>
  <div id="top">
    <Header />

    <main
      class="mx-auto flex w-full max-w-7xl flex-col gap-28 overflow-x-hidden px-6 py-16 sm:py-24"
    >
      <!-- HERO -->
      <section class="grid items-center gap-14 lg:grid-cols-2">
        <div class="flex flex-col gap-8">
          <div
            class="inline-flex w-fit items-center gap-2 rounded-full border border-white/15 bg-white/[0.06] px-4 py-1.5 text-xs uppercase tracking-[0.3em] text-slate-200 backdrop-blur"
          >
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
            Autonomous QA · Playwright · AI Agents
          </div>

          <div class="flex flex-col gap-6">
            <h1
              class="text-balance bg-gradient-to-b from-white via-slate-100 to-slate-400 bg-clip-text text-4xl font-semibold tracking-tight text-transparent sm:text-5xl lg:text-6xl"
            >
              Scaffold de QA autónomo en un comando
            </h1>
            <p
              class="max-w-xl text-pretty text-lg leading-relaxed text-slate-300"
            >
              <code class="font-mono text-indigo-300">create-autonomous-qa</code>
              {" "}
              genera proyectos de pruebas con Playwright, TypeScript y una skill
              de 9 fases para agentes de IA. Estructura completa, package
              manager incluido y cero configuración manual.
            </p>
          </div>

          <div class="flex flex-wrap items-center gap-3">
            <a
              href="#install"
              class="inline-flex items-center gap-2 rounded-full bg-indigo-500 px-6 py-3 text-sm font-medium text-white shadow-glow transition hover:-translate-y-0.5 hover:bg-indigo-400"
            >
              Instalar con npx
              <span aria-hidden="true">→</span>
            </a>
            <a
              href="https://github.com/david-perez-zuniga/create-autonomous-qa"
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/[0.06] px-6 py-3 text-sm text-slate-200 backdrop-blur transition hover:-translate-y-0.5 hover:border-indigo-400/60 hover:bg-white/10"
            >
              Ver en GitHub
            </a>
          </div>

          <dl class="grid grid-cols-2 gap-6 border-t border-white/10 pt-8 sm:grid-cols-4">
            {
              stats.map((stat) => (
                <div class="flex flex-col gap-1">
                  <dt class="font-mono text-2xl font-semibold text-white">
                    {stat.value}
                  </dt>
                  <dd class="text-xs uppercase tracking-wider text-slate-400">
                    {stat.label}
                  </dd>
                </div>
              ))
            }
          </dl>
        </div>

        <div class="lg:pl-4">
          <Terminal />
        </div>
      </section>

      <!-- INSTALL -->
      <section id="install" class="flex flex-col gap-10 scroll-mt-24">
        <div class="flex flex-col items-center gap-4 text-center">
          <span
            class="font-mono text-xs uppercase tracking-[0.4em] text-indigo-400"
            >instalación</span
          >
          <h2 class="text-3xl font-semibold text-white sm:text-4xl">
            Elige tu gestor de paquetes
          </h2>
          <p class="max-w-2xl text-pretty text-lg text-slate-300">
            Funciona igual con npm, pnpm, Bun o <code class="font-mono"
              >npx</code
            >. No necesitas instalación global.
          </p>
        </div>

        <div class="grid gap-4 lg:grid-cols-2">
          {
            installCommands.map((item) => (
              <button
                type="button"
                data-copy={item.cmd}
                class="group flex w-full min-w-0 items-center justify-between gap-3 rounded-2xl border border-white/10 bg-white/[0.03] px-5 py-4 text-left transition hover:border-indigo-400/60 hover:bg-white/[0.06] sm:gap-4 sm:px-6 sm:py-5"
              >
                <span class="flex min-w-0 flex-1 items-center gap-3 sm:gap-4">
                  <span class="shrink-0 rounded-lg border border-white/10 bg-black/30 px-2.5 py-1 font-mono text-xs uppercase text-slate-300">
                    {item.pm}
                  </span>
                  <code
                    class="min-w-0 break-all font-mono text-xs text-slate-100 sm:truncate sm:text-sm"
                  >
                    {item.cmd}
                  </code>
                </span>
                <span
                  data-copy-label
                  class="hidden shrink-0 text-xs uppercase tracking-widest text-slate-500 transition group-hover:text-indigo-300 sm:block"
                >
                  Copiar
                </span>
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 16 16"
                  fill="none"
                  data-copy-icon
                  class="shrink-0 text-slate-500 transition group-hover:text-indigo-300 sm:hidden"
                  aria-hidden="true"
                >
                  <rect
                    x="5.5"
                    y="5.5"
                    width="8"
                    height="8"
                    rx="2"
                    stroke="currentColor"
                    stroke-width="1.4"
                  />
                  <path
                    d="M10.5 3.5v-.5a2 2 0 0 0-2-2h-5a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2h.5"
                    stroke="currentColor"
                    stroke-width="1.4"
                    stroke-linecap="round"
                  />
                </svg>
              </button>
            ))
          }
        </div>

        <div
          class="rounded-3xl border border-white/10 bg-white/[0.03] p-8 backdrop-blur-xl"
        >
          <h3 class="text-lg font-semibold text-white">Opciones de la CLI</h3>
          <div
            class="mt-5 grid gap-3 font-mono text-sm sm:grid-cols-2 lg:grid-cols-3"
          >
            {
              [
                { flag: "--pnpm", desc: "Usa pnpm (por defecto)" },
                { flag: "--bun", desc: "Usa Bun" },
                { flag: "--debug", desc: "Muestra stack traces" },
                { flag: "--help", desc: "Muestra la ayuda" },
                { flag: "--version", desc: "Muestra la versión" },
                { flag: "<project-name>", desc: "Nombre del proyecto" },
              ].map((opt) => (
                <div class="flex flex-wrap items-center gap-x-3 gap-y-1 rounded-xl border border-white/5 bg-black/20 px-4 py-3">
                  <span class="shrink-0 text-indigo-300">{opt.flag}</span>
                  <span class="hidden text-slate-500 sm:inline">—</span>
                  <span class="text-slate-400">{opt.desc}</span>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <!-- FEATURES -->
      <section id="features" class="flex flex-col gap-10 scroll-mt-24">
        <div class="flex flex-col items-center gap-4 text-center">
          <span
            class="font-mono text-xs uppercase tracking-[0.4em] text-indigo-400"
            >features</span
          >
          <h2 class="text-3xl font-semibold text-white sm:text-4xl">
            Todo lo que necesitas para empezar
          </h2>
          <p class="max-w-3xl text-pretty text-lg text-slate-300">
            De la estructura de carpetas a la skill de agentes: la CLI se
            encarga del andamiaje completo.
          </p>
        </div>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {features.map((feature) => <Card {...feature} />)}
        </div>
      </section>

      <!-- TREE -->
      <section class="grid items-center gap-12 lg:grid-cols-2">
        <div class="flex flex-col gap-6">
          <span
            class="font-mono text-xs uppercase tracking-[0.4em] text-cyan-400"
            >estructura</span
          >
          <h2 class="text-3xl font-semibold text-white sm:text-4xl">
            Un proyecto pensado para QA
          </h2>
          <p
            class="text-pretty text-lg leading-relaxed text-slate-300"
          >
            Cada carpeta tiene un propósito claro: tests, Page Objects, fixtures
            y evidencias separadas por tipo. El <code class="font-mono"
              >.gitignore</code
            > ya viene configurado para ignorar artefactos de ejecución y
            conservar la estructura.
          </p>
          <ul class="flex flex-col gap-3">
            {
              [
                "Evidencias separadas en screenshots, videos, traces, console y network",
                "Analytics y defectos en carpetas dedicadas",
                "Reportes HTML y JSON de Playwright configurados",
                "Skill de OpenCode lista para agentes de IA",
              ].map((item) => (
                <li class="flex items-start gap-3 text-slate-300">
                  <svg
                    width="18"
                    height="18"
                    viewBox="0 0 18 18"
                    fill="none"
                    class="mt-0.5 shrink-0 text-emerald-400"
                    aria-hidden="true"
                  >
                    <path
                      d="M3.5 9.5l3.5 3.5 7.5-8"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>
        </div>
        <Tree />
      </section>

      <!-- PHASES -->
      <section id="fases" class="flex flex-col gap-10 scroll-mt-24">
        <div class="flex flex-col items-center gap-4 text-center">
          <span
            class="font-mono text-xs uppercase tracking-[0.4em] text-indigo-400"
            >skill autonomous-qa</span
          >
          <h2 class="text-3xl font-semibold text-white sm:text-4xl">
            9 fases para QA autónomo
          </h2>
          <p class="max-w-3xl text-pretty text-lg text-slate-300">
            El proyecto generado incluye una skill que guía al agente desde el
            descubrimiento funcional hasta el reporte final.
          </p>
        </div>
        <Phases />
      </section>

      <!-- FAQ -->
      <section id="faq" class="flex flex-col gap-10 scroll-mt-24">
        <div class="flex flex-col items-center gap-4 text-center">
          <span
            class="font-mono text-xs uppercase tracking-[0.4em] text-cyan-400"
            >preguntas</span
          >
          <h2 class="text-3xl font-semibold text-white sm:text-4xl">
            Preguntas frecuentes
          </h2>
        </div>
        <Faq />
      </section>

      <!-- CTA -->
      <section
        class="relative flex flex-col items-center gap-8 overflow-hidden rounded-[2rem] border border-white/10 bg-gradient-to-br from-indigo-600/20 via-background to-cyan-500/10 px-8 py-16 text-center shadow-glow backdrop-blur-xl"
      >
        <div
          class="pointer-events-none absolute -top-32 left-1/2 h-64 w-[36rem] -translate-x-1/2 rounded-full bg-indigo-500/30 blur-3xl"
        >
        </div>
        <div class="relative flex flex-col gap-4">
          <h2 class="text-3xl font-semibold text-white sm:text-4xl">
            Empieza tu QA autónomo hoy
          </h2>
          <p class="max-w-2xl text-pretty text-lg text-slate-200">
            Un comando y tienes el proyecto listo: estructura, configuración,
            skill y próximos pasos.
          </p>
        </div>
        <div class="relative flex w-full max-w-full flex-col items-center gap-4">
          <code
            class="max-w-full overflow-x-auto rounded-2xl border border-white/15 bg-black/40 px-5 py-4 text-left font-mono text-xs text-white backdrop-blur sm:px-6 sm:text-base"
            >npx create-autonomous-qa@latest mi-proyecto</code
          >
          <a
            href="https://www.npmjs.com/package/create-autonomous-qa"
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 rounded-full bg-white px-6 py-3 text-sm font-medium text-slate-900 transition hover:-translate-y-0.5 hover:bg-slate-100"
          >
            Ver en npm
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </section>

      <!-- FOOTER -->
      <footer
        class="flex flex-col items-center justify-between gap-6 border-t border-white/10 py-8 text-sm text-slate-400 sm:flex-row"
      >
        <p>
          Creado por <span class="text-slate-200">David Humberto Perez Zuniga</span>
          · MIT License
        </p>
        <div class="flex flex-wrap items-center justify-center gap-5">
          <a
            href="https://github.com/david-perez-zuniga/create-autonomous-qa"
            target="_blank"
            rel="noopener"
            class="transition hover:text-slate-200">GitHub</a
          >
          <a
            href="https://www.npmjs.com/package/create-autonomous-qa"
            target="_blank"
            rel="noopener"
            class="transition hover:text-slate-200">npm</a
          >
          <a href="#top" class="transition hover:text-slate-200"
            >Volver arriba ↑</a
          >
        </div>
      </footer>
    </main>
  </div>
</BaseLayout>

<script>
  // Copiar al portapapeles
  document.querySelectorAll<HTMLElement>("[data-copy]").forEach((button) => {
    button.addEventListener("click", async () => {
      const command = button.dataset.copy;
      if (!command) return;

      const label = button.querySelector<HTMLElement>("[data-copy-label]");
      const icon = button.querySelector<HTMLElement>("[data-copy-icon]");
      const original = label?.textContent ?? "";

      try {
        await navigator.clipboard.writeText(command);
        if (label) {
          label.textContent = "Copiado ✓";
          label.classList.add("opacity-100");
        }
        if (icon) {
          icon.classList.add("text-emerald-400");
          icon.classList.remove("text-slate-500");
        }
        setTimeout(() => {
          if (label) {
            label.textContent = original;
            label.classList.remove("opacity-100");
          }
          if (icon) {
            icon.classList.remove("text-emerald-400");
            icon.classList.add("text-slate-500");
          }
        }, 1800);
      } catch (error) {
        console.error("No se pudo copiar el comando", error);
      }
    });
  });

  // Revelado al hacer scroll
  const targets = document.querySelectorAll<HTMLElement>(
    "#features article, #fases > div > div, #install > div, #faq > div"
  );

  if ("IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("reveal-visible");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15 }
    );

    targets.forEach((target) => {
      target.classList.add("reveal");
      observer.observe(target);
    });
  }
</script>

<style>
  .reveal {
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .reveal-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
